<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_mtr_linked" model="ir.ui.view">
        <field name="name">res.partner.form.mtr.linked</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_linked_companies" type="object" class="oe_stat_button"
                        icon="fa-building" invisible="not linked_company_count">
                    <field name="linked_company_count" widget="statinfo" string="Linked Companies"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']/group[@name='container_row_2']" position="inside">
                <group string="Company Group" name="mtr_linked_companies">
                    <field name="is_linked_company" invisible="not parent_id"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='function']/parent::div" position="after">
                <div class="d-flex align-items-baseline w-md-50 gap-2" invisible="type != 'contact'">
                    <i class="oi oi-filled d-none d-md-block" data-icon="building" title="Independent Company"/>
                    <field name="is_linked_company"/>
                </div>
                <div class="d-flex align-items-baseline w-md-50 gap-2" invisible="not is_linked_company">
                    <i class="oi oi-filled d-none d-md-block" data-icon="id-card" title="Tax ID"/>
                    <field name="vat" placeholder="Tax ID"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_mtr_linked" model="ir.ui.view">
        <field name="name">res.partner.search.mtr.linked</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <separator/>
                <filter name="linked_companies" string="Linked Companies"
                        domain="[('is_linked_company', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
