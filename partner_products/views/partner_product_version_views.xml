<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_product_version_list_view" model="ir.ui.view">
        <field name="name">partner.product.version.list</field>
        <field name="model">partner.product.version</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="product_tmpl_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>
    <record id="partner_product_version_form_view" model="ir.ui.view">
        <field name="name">partner.product.version.form</field>
        <field name="model">partner.product.version</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                    <field name="active" invisible="1" />
                </group>
                <field name="product_tmpl_ids" nolabel="1">
                    <list>
                        <field name="name" />
                        <field name="default_code" />
                        <field name="categ_id" />
                    </list>
                </field>
            </form>
        </field>
    </record>
    <record id="partner_product_version_action" model="ir.actions.act_window">
        <field name="name">Product Groups</field>
        <field name="res_model">partner.product.version</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_partner_products_root"
        name="Customer Products"
        parent="contacts.menu_contacts"
        sequence="20"
    />
    <menuitem
        id="menu_partner_product_version"
        name="Product Groups"
        parent="menu_partner_products_root"
        action="partner_product_version_action"
        sequence="20"
    />
</odoo>
