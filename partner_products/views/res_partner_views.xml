<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_view" model="ir.ui.view">
        <field name="name">res.partner.form.partner.products</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_partner_products"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cube"
                >
                    <field
                        name="partner_product_count"
                        widget="statinfo"
                        string="Products"
                    />
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="customer_products" string="Products">
                    <button
                        name="action_open_product_bulk_add"
                        type="object"
                        string="Bulk Add Products"
                        class="btn btn-secondary mb-2"
                    />
                    <field name="partner_product_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field
                                name="product_id"
                                options="{'no_create_edit': True}"
                            />
                            <field name="product_tmpl_id" column_invisible="1" />
                            <field
                                name="version_id"
                                domain="['|', ('product_tmpl_ids', '=', False), ('product_tmpl_ids', 'in', [product_tmpl_id])]"
                            />
                            <field name="note" optional="hide" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
