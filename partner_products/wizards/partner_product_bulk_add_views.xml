<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_product_bulk_add_form_view" model="ir.ui.view">
        <field name="name">partner.product.bulk.add.form</field>
        <field name="model">partner.product.bulk.add</field>
        <field name="arch" type="xml">
            <form string="Add Products">
                <field name="partner_id" invisible="1" />
                <group>
                    <field name="version_id" />
                    <field name="categ_id" />
                    <field name="tag_ids" widget="many2many_tags" />
                </group>
                <field name="product_ids" nolabel="1">
                    <list>
                        <field name="name" />
                        <field name="default_code" />
                        <field name="categ_id" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_add"
                        string="Add Products"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" special="cancel" class="oe_secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
